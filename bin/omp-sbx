#!/bin/bash

set -euo pipefail

name="omp-$(basename "$PWD")"
omp_kit="${OMP_KIT:-git+https://github.com/fgladisch/sbx-kit-omp-dev-shell.git}"
skills_dir="${OMP_SKILLS_DIR:-${HOME}/code/omp-skills/skills}"
commands_dir="${OMP_COMMANDS_DIR:-${HOME}/code/omp-skills/commands}"

sandbox_names=""
if ! sandbox_names="$(sbx ls -q)"; then
  echo "ERROR: failed to list sandboxes; refusing to create '$name'." >&2
  exit 1
fi

sandbox_exists=false
while IFS= read -r sandbox_name; do
  if [[ "$sandbox_name" == "$name" ]]; then
    sandbox_exists=true
    break
  fi
done <<< "$sandbox_names"

if [[ "$sandbox_exists" == false ]]; then
  sbx create \
    --name "$name" \
    --kit "$omp_kit" \
    omp "$PWD"
  sbx exec "$name" -- mkdir -p /home/agent/.omp
  sbx cp "$HOME/.omp/agent" "$name:/home/agent/.omp"
  sbx exec -u root "$name" -- rm -rf /home/agent/.omp/agent/commands
  sbx cp "$commands_dir" "$name:/home/agent/.omp/agent/commands"
  sbx exec -u root "$name" -- chown -R 1000:1000 /home/agent/.omp/agent
  sbx exec "$name" -- mkdir -p /home/agent/.agents
  sbx cp "$skills_dir" "$name:/home/agent/.agents/skills"
  sbx exec -u root "$name" -- chown -R 1000:1000 /home/agent/.agents/skills
fi

sbx exec "$name" -- omp update --plugins
sbx run --name "$name" -- "$@"
